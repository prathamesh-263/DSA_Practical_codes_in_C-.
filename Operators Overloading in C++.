
#include<iostream>
using namespace std;

class complex
{
    private:
    float real;
    float imag;

    public:
    complex()
    {
        real=0;
        imag=0;
    }

    complex(float r,float i)
    {
        real=r;
        imag=i;
    }

    ~complex(){}

    complex operator+(complex c)
    {
        return complex(real+c.real,imag+c.imag);
    }

    complex operator-(complex c)
    {
        return complex(real-c.real,imag-c.imag);
    }

    complex operator*(complex c)
    {
        float r=real*c.real-imag*c.imag;
        float i=real*c.imag+imag*c.real;

        return complex(r,i);
    }

    void display()
    {
        cout<<real<<"+"<<imag<<"i"<<endl;
    }
};

int main()
{
    complex c1(5,9);
    complex c2(4,8);

    cout<<"First Complex No :";
    c1.display();

    cout<<"Second Complex No :";
    c2.display();

    complex sum=c1+c2;
    cout<<"Addition :";
    sum.display();

    complex sub=c1-c2;
    cout<<"Subtraction :";
    sub.display();

    complex prod=c1*c2;
    cout<<"Multiplication :";
    prod.display();

    return 0;
}
